# --- server ---
NODE_ENV=development
PORT=4000

# Frontend origin allowed by CORS (comma-separated list supported)
CORS_ORIGIN=http://localhost:5173

# --- database ---
# SQLite for dev. The Prisma schema is written so the same models work on PostgreSQL.
DATABASE_URL="file:./dev.db"
# PostgreSQL example (prod):
# DATABASE_URL="postgresql://user:password@localhost:5432/yourctf?schema=public"

# Public frontend URL, used for links in verification and reset emails.
APP_BASE_URL=http://localhost:5173

# --- auth ---
# Long random string. Generate with: openssl rand -hex 32
# Production refuses to boot on the development default or < 32 characters.
JWT_SECRET=replace-me-with-a-long-random-secret
JWT_EXPIRES_IN=7d
COOKIE_NAME=yourctf_session
# Must be true in production (HTTPS deployments only).
COOKIE_SECURE=false
# When true, flag submissions require a verified email address.
REQUIRE_EMAIL_VERIFICATION=false

# --- email (verification + password reset) ---
# console logs links in development. webhook POSTs JSON to MAIL_WEBHOOK_URL.
# Production requires this to be set; configure webhook for real delivery.
MAIL_TRANSPORT=console
# MAIL_WEBHOOK_URL=https://mail.example.com/hooks/yourctf
MAIL_FROM="YourCTF <no-reply@yourctf.local>"

# --- flags & uploads ---
# Default hash algorithm for new flags; each flag stores its own algo, so
# changing this never breaks existing flags.
FLAG_HASH_ALGORITHM=sha256
# When true, admin submission listings also show an 8-char prefix of the
# salted hash of a wrong attempt (never the attempt itself).
WRONG_ATTEMPT_DISPLAY_PREFIX=false
# Handout uploads: stored under this directory with random names.
UPLOAD_DIR=./uploads
UPLOAD_MAX_BYTES=5242880

# --- rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=10
SUBMIT_RATE_LIMIT_MAX=30

# --- seed / bootstrap admin (used by prisma/seed.ts) ---
# Production refuses to boot on the default password.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@yourctf.local
ADMIN_PASSWORD=ChangeMe123!
